---
import { loja, srcsetDe } from "../scripts/lib";
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(loja.hero.imagem, Astro.site);
---

<!doctype html>
<html lang="pt-BR" data-paleta={loja.paleta}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={loja.corNavegador} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Teste rápido de paleta pela URL: ?paleta=vinho
      try {
        const p = new URLSearchParams(location.search).get("paleta");
        if (p) document.documentElement.dataset.paleta = p;
      } catch {}
    </script>
    <link rel="canonical" href={canonicalURL} />
    <title>{loja.seo.titulo}</title>
    <meta name="description" content={loja.seo.descricao} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={loja.seo.titulo} />
    <meta property="og:description" content={loja.seo.descricao} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..100,400..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={loja.hero.imagemMobile} imagesrcset={srcsetDe(loja.hero.imagemMobile)} imagesizes="100vw" media="(max-width: 760px)" fetchpriority="high" />
    <link rel="preload" as="image" href={loja.hero.imagem} imagesrcset={srcsetDe(loja.hero.imagem)} imagesizes="100vw" media="(min-width: 761px)" fetchpriority="high" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Restaurant",
        name: loja.nome,
        url: Astro.site?.toString(),
        telephone: "+" + loja.whatsapp,
        servesCuisine: "Brasileira",
        hasMenu: new URL("/#cardapio", Astro.site).toString(),
        address: {
          "@type": "PostalAddress",
          streetAddress: loja.endereco.rua,
          addressLocality: loja.endereco.cidade,
        },
        openingHoursSpecification: loja.horarios.map((h) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][h.dia],
          opens: h.abre,
          closes: h.fecha,
        })),
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
